# ===== 运行期缓存与中间产物（不入库）=====
temp/
output/
dist/
build/
__pycache__/
*.py[cod]
*.log
edge_profile/
mfprof_*/
mf_cdp_*/
mf_guard_*/
mf_mask_*/
mf_pack_*/
mf_perf/
*.pid
*.raw.txt

# ===== 本地环境 =====
.venv/
venv/
env/
node_modules/
*.egg-info/
.pytest_cache/

# ===== 编辑器 / 操作系统 =====
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ===== 密钥与本地配置（严禁入库）=====
.env
.env.*
*.local.json
secrets.json

# ===== 反例：证据目录的真机日志必须入库 =====
# *.log 是给运行期调试残留准备的排除项；但 docs/evidence/*.log 是 core/compat.py
# 里 verified.evidence 直接指向的取证本体。全局排除等于源码仓库无法自证"支持某版本"，
# 和打包侧 EXCLUDE_SUFFIX 排除 .log 是同一类静默断链，必须显式放行。
!docs/evidence/
!docs/evidence/*.log
